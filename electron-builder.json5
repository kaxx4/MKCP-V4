{
  appId: "com.mkcycles.dashboard",
  productName: "MK Cycles Dashboard",
  copyright: "Copyright © 2025 M.K. Cycles (P) Ltd.",
  directories: {
    buildResources: "public",
    output: "release2",            // Separate from dist/ so dist/**/* doesn't bundle previous builds
  },
  files: [
    // React build (self-contained — no node_modules needed at runtime)
    "dist/**/*",
    "!dist/electron/**",         // Safety: exclude any old electron output inside dist/
    // Vite's publicDir copies the electron shell (electron.js/preload.js/package.json)
    // from public/ into dist/. Those are redundant in the asar — the canonical copies
    // are bundled from public/ below. Exclude the dist/ duplicates so we don't ship
    // (and risk loading) two copies. dist/favicon.svg is a real web asset → kept.
    "!dist/electron.js",
    "!dist/preload.js",
    "!dist/package.json",
    "!dist/icon.png",
    // Electron shell (canonical copies)
    "public/electron.js",
    "public/preload.js",
    "public/favicon.svg",
    "public/icon.png",
    "public/package.json",
    "package.json",
    // Explicitly exclude everything else that would bloat the asar
    "!node_modules/**",
    "!server/**",
    "!src/**",
    "!scripts/**",
    "!*.md",
  ],
  extraResources: [
    {
      // Server runs in the main process via require(process.resourcesPath/server/dist/index.js)
      // — it lives OUTSIDE the asar so it can resolve its own node_modules at runtime.
      //
      // ".env" is bundled from the LOCAL, gitignored server/.env on the build
      // machine (never committed) — public/electron.js's loadPackagedEnv()
      // reads it from resourcesPath/server/.env at startup. This replaces a
      // hardcoded Supabase service-role key that used to live directly in
      // electron.js as the "packaged builds can't read server/.env" fallback;
      // that literal got committed to git and must be treated as dead
      // regardless of rotation status. Make sure the build machine's
      // server/.env has real values before running build:prod — a missing
      // file just means Supabase-dependent features self-disable (see
      // loadPackagedEnv()'s warning), it won't fail the build or crash the app.
      from: "server",
      to: "server",
      filter: ["dist/**/*", "package.json", "node_modules/**/*", ".env"],
    },
  ],
  extraMetadata: {
    main: "public/electron.js",
  },
  win: {
    target: [{ target: "nsis", arch: ["x64"] }],
    icon: "public/icon.png",
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "MK Cycles Dashboard",
  },
  compression: "maximum",  // 7z maximum compression → ~15-20% smaller installer (slower build)
  publish: null,
}
