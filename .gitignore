# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local
.vite/

# Environment
.env
.env.local
.env.production.local
.env.development.local

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Data files
Transactions.json
Master.json
public/sample/masters.json
public/sample/transactions.json

# Backup files (generated by Erase Data feature)
MKCP_full_backup_*.json
backup_*.json
*_backup_*.json

# Tally test data (exported from TallyPrime)
TALLY TEST*/
TALLY_TEST*/
*tally_test*
*.tally

# Electron build output (installers — do not commit binaries)
release/
release_new/
release*/

# Known-unused scaffold/backup directories — never tracked, but a broad
# `git add -A` would happily stage them without this.
server_backup_/
my-app/

# Python bytecode from skill scripts
__pycache__/
*.pyc

# Exploration artefacts — large raw Tally dumps, regenerable by scripts/explore-*.ts
server/exploration-*.json
server/.voucher-cache.xml

# Diagnostic logs — local only, can grow large, never shared
server/data/*.jsonl
server/data/*.jsonl.*
server/data/gstr-baseline.json

# Any backup or variant of an env file. `.env` alone did not cover
# `server/.env.bak-before-golive-20260914`, which holds the live service-role
# key in plaintext and sat untracked-but-committable for a day. A secret one
# `git add -A` away from the history is a secret already leaking.
.env.*
*.env
!.env.example

# Runtime artifacts the server writes beside itself when started from the
# server/ directory (smoke tests, manual runs). Data, not source.
server/server/
**/data/tally-log.jsonl

# Generated by scripts/build-prod.js for MKCP_EMBED_ENV=1 builds. Never commit:
# it is the config that puts the live service-role key inside an installer.
electron-builder.provisioning.json5
server/data/*-probe.json

# Real-business sample data. These were already ignored at public/sample/, but
# .gitignore only keeps a file out of the REPO — Vite copies public/ into dist/
# and electron-builder's extraResources bundles dist/** into the installer, so
# they were shipping in every build and would have been uploaded to the PUBLIC
# kaxx4/MKCP-V4 release. Moved here on 19-Sep-2026, where nothing bundles them.
sample-data/

# Push-fidelity / native-shape harness output: real party names, GSTINs and
# addresses read back from Tally. Never commit (this repo is public).
server/data/native-shape/
server/data/native-sales-census.json
server/data/push-fidelity-*
# Throwaway probe scripts written during investigations.
server/scripts/_scratch-*.ts
